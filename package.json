    "@sentry/nextjs": "^10.53.1",
    "@uiw/react-md-editor": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "next-sanity": "^12.3.0",
